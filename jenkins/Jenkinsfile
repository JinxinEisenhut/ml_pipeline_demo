pipeline {

    agent any

    environment {
        MLFLOW_TRACKING_URI = credentials('mlflow-tracking-uri')
        DOCKER_REGISTRY     = "localhost:5050"
        IMAGE_NAME          = "iris-classifier"
        IMAGE_TAG           = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
        MIN_ACCURACY        = "0.90"
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }

    parameters {
        string(name: 'N_ESTIMATORS', defaultValue: '100', description: 'Anzahl Bäume im RandomForest')
        string(name: 'MAX_DEPTH',    defaultValue: 'None', description: 'Maximale Baumtiefe')
        choice(name: 'ENVIRONMENT',  choices: ['staging', 'production'], description: 'Ziel-Umgebung')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "=== Build #${BUILD_NUMBER} | Commit: ${GIT_COMMIT} | Branch: ${GIT_BRANCH} ==="
                echo "N_ESTIMATORS=${params.N_ESTIMATORS} | MAX_DEPTH=${params.MAX_DEPTH}"
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build \\
                        --tag ${DOCKER_REGISTRY}/${IMAGE_NAME}-train:${IMAGE_TAG} \\
                        --tag ${DOCKER_REGISTRY}/${IMAGE_NAME}-train:latest \\
                        --file docker/Dockerfile.train \\
                        .
                """
            }
        }

        stage('Tests') {
            steps {
                sh """
                    docker run --rm \\
                        --volume ${WORKSPACE}:/app/workspace \\
                        --workdir /app \\
                        ${DOCKER_REGISTRY}/${IMAGE_NAME}-train:${IMAGE_TAG} \\
                        sh -c "pytest tests/ -v --tb=short --junitxml=/app/workspace/test-results.xml"
                """
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results.xml'
                }
            }
        }

        stage('Training') {
            steps {
                sh """
                    docker run --rm \\
                        --network host \\
                        --volume ${WORKSPACE}:/app/workspace \\
                        --env MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI} \\
                        --env N_ESTIMATORS=${params.N_ESTIMATORS} \\
                        --env MAX_DEPTH=${params.MAX_DEPTH} \\
                        --env MIN_ACCURACY=${MIN_ACCURACY} \\
                        --env RANDOM_STATE=42 \\
                        ${DOCKER_REGISTRY}/${IMAGE_NAME}-train:${IMAGE_TAG}
                """
            }
        }

        stage('Build Serving Image') {
            steps {
                sh """
                    docker build \\
                        --tag ${DOCKER_REGISTRY}/${IMAGE_NAME}-serve:${IMAGE_TAG} \\
                        --tag ${DOCKER_REGISTRY}/${IMAGE_NAME}-serve:latest \\
                        --file docker/Dockerfile.serve \\
                        .
                """
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    docker stop iris-serve || true
                    docker rm   iris-serve || true
                    docker run -d \\
                        --name iris-serve \\
                        --network host \\
                        --restart unless-stopped \\
                        --env MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI} \\
                        --env MODEL_URI=models:/IrisClassifier/Production \\
                        --env PORT=8080 \\
                        ${DOCKER_REGISTRY}/${IMAGE_NAME}-serve:${IMAGE_TAG}
                    sleep 10
                    curl --fail --silent http://localhost:8080/health && echo "Deploy OK" || exit 1
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline #${BUILD_NUMBER} erfolgreich! Tag: ${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline #${BUILD_NUMBER} fehlgeschlagen."
        }
        always {
            sh 'rm -f test-results.xml || true'
            sh 'docker image prune -f || true'
        }
    }
}
